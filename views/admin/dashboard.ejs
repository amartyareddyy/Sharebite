<main>
	<%- include('../partials/adminSidebar') %>
	
	<div id="main-wrapper">
		<div class="dashboard-header">
			<div class="container">
				<div class="row align-items-center">
					<div class="col-md-8">
						<h1>Welcome back, Admin!</h1>
						<p>Here's what's happening with your food donation system today.</p>
					</div>
					<div class="col-md-4 text-end">
						<img src="/assets/images/admin-illustration.svg" alt="Admin Dashboard" class="img-fluid" style="max-height: 150px;" onerror="this.style.display='none'">
					</div>
				</div>
			</div>
		</div>
		
		<div class="container py-4">
			<div class="row mb-4">
				<div class="col-12">
					<div class="card border-0 shadow-sm">
						<div class="card-body">
							<div class="row">
								<div class="col-md-3">
									<div class="stats-card text-center">
										<i class="fas fa-users"></i>
										<div class="number"><%= numAdmins || 0 %></div>
										<div>Admins</div>
									</div>
								</div>
								<div class="col-md-3">
									<div class="stats-card text-center">
										<i class="fas fa-hand-holding-heart"></i>
										<div class="number"><%= numDonors || 0 %></div>
										<div>Donors</div>
									</div>
								</div>
								<div class="col-md-3">
									<div class="stats-card text-center">
										<i class="fas fa-truck"></i>
										<div class="number"><%= numAgents || 0 %></div>
										<div>Agents</div>
									</div>
								</div>
								<div class="col-md-3">
									<div class="stats-card text-center">
										<i class="fas fa-utensils"></i>
										<div class="number"><%= numPendingDonations || 0 %></div>
										<div>Pending Donations</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-6 mb-4">
					<div class="card border-0 shadow-sm h-100">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-center mb-4">
								<h5 class="card-title color-theme mb-0">
									<i class="fas fa-clock me-2"></i>Recent Donations
								</h5>
								<a href="/admin/donations/pending" class="btn btn-sm btn-primary">
									View All
								</a>
							</div>
							<div class="table-responsive">
								<table class="table">
									<thead>
										<tr>
											<th>Donor</th>
											<th>Status</th>
											<th>Action</th>
										</tr>
									</thead>
									<tbody>
										<% if (pendingDonations && pendingDonations.length > 0) { %>
											<% pendingDonations.forEach(donation => { %>
												<tr>
													<td>
														<div class="d-flex align-items-center">
															<img src="<%= donation.donor.profileImage || '/assets/images/default-avatar.png' %>" 
																 alt="<%= donation.donor.firstName %>" 
																 class="rounded-circle me-2"
																 style="width: 35px; height: 35px; object-fit: cover;"
																 onerror="this.src='/assets/images/default-avatar.png'">
															<%= donation.donor.firstName %> <%= donation.donor.lastName %>
														</div>
													</td>
													<td>
														<span class="status-badge status-pending">
															<i class="fas fa-clock me-1"></i>Pending
														</span>
													</td>
													<td>
														<a href="/admin/donation/view/<%= donation._id %>" class="btn btn-sm btn-primary">
															<i class="fas fa-eye me-1"></i>View
														</a>
													</td>
												</tr>
											<% }) %>
										<% } else { %>
											<tr>
												<td colspan="3" class="text-center">No pending donations</td>
											</tr>
										<% } %>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>

				<div class="col-md-6 mb-4">
					<div class="card border-0 shadow-sm h-100">
						<div class="card-body">
							<h5 class="card-title color-theme mb-4">
								<i class="fas fa-chart-line me-2"></i>Donation Statistics
							</h5>
							<div class="row text-center">
								<div class="col-6 mb-3">
									<div class="stats-card">
										<i class="fas fa-check-circle"></i>
										<div class="number"><%= numAcceptedDonations || 0 %></div>
										<div>Accepted</div>
									</div>
								</div>
								<div class="col-6 mb-3">
									<div class="stats-card">
										<i class="fas fa-user-check"></i>
										<div class="number"><%= numAssignedDonations || 0 %></div>
										<div>Assigned</div>
									</div>
								</div>
								<div class="col-6">
									<div class="stats-card">
										<i class="fas fa-truck-loading"></i>
										<div class="number"><%= numCollectedDonations || 0 %></div>
										<div>Collected</div>
									</div>
								</div>
								<div class="col-6">
									<div class="stats-card">
										<i class="fas fa-utensils"></i>
										<div class="number"><%= numPendingDonations || 0 %></div>
										<div>Pending</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Recent Completed Donations with Images -->
			<div class="mt-5">
				<h5 class="card-title color-theme mb-4">
					<i class="fas fa-check-circle me-2"></i>Recent Completed Donations
				</h5>
				<div class="row g-4">
					<% if (completedDonations && completedDonations.length > 0) { %>
						<% completedDonations.forEach(donation => { %>
							<div class="col-md-4">
								<div class="card h-100">
									<img src="<%= donation.collectionImage %>" class="card-img-top" alt="Collection Image" style="height: 200px; object-fit: cover;">
									<div class="card-body">
										<h5 class="card-title text-success"><%= donation.foodType %></h5>
										<div class="mb-2">
											<i class="fas fa-user me-2 text-success"></i>
											<span>Donor: <%= donation.donor.firstName + " " + donation.donor.lastName %></span>
										</div>
										<div class="mb-2">
											<i class="fas fa-users me-2 text-success"></i>
											<span>Quantity: <%= donation.quantity %> persons</span>
										</div>
										<div class="mb-2">
											<i class="fas fa-truck me-2 text-success"></i>
											<span>Agent: <%= donation.agent.firstName + " " + donation.agent.lastName %></span>
										</div>
										<div class="mb-2">
											<i class="fas fa-clock me-2 text-success"></i>
											<span>Collected: <%= new Date(donation.collectionTime).toLocaleString() %></span>
										</div>
										<div class="mt-2">
											<span class="badge bg-success"><%= donation.status %></span>
										</div>
									</div>
								</div>
							</div>
						<% }); %>
					<% } else { %>
						<div class="col-12">
							<div class="text-center text-muted">
								<p>No completed donations with images yet.</p>
							</div>
						</div>
					<% } %>
				</div>
			</div>

			<!-- Quick Actions Section -->
			<div class="row mt-5">
				<div class="col-12">
					<div class="quick-actions">
						<h5 class="card-title color-theme mb-4">
							<i class="fas fa-tasks me-2"></i>Quick Actions
						</h5>
						<div class="row g-3">
							<div class="col-md-3">
								<a href="/admin/donations/pending" class="btn btn-primary w-100">
									<i class="fas fa-clock me-2"></i>
									<span>Pending Donations</span>
								</a>
							</div>
							<div class="col-md-3">
								<a href="/admin/donations/previous" class="btn btn-primary w-100">
									<i class="fas fa-history me-2"></i>
									<span>Previous Donations</span>
								</a>
							</div>
							<div class="col-md-3">
								<a href="/admin/agents" class="btn btn-primary w-100">
									<i class="fas fa-truck me-2"></i>
									<span>Manage Agents</span>
								</a>
							</div>
							<div class="col-md-3">
								<a href="/admin/profile" class="btn btn-primary w-100">
									<i class="fas fa-user me-2"></i>
									<span>My Profile</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</main>