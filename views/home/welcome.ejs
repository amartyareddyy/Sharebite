				<a href="/auth/signup" class="btn btn-primary btn-lg">Join Our Cause</a>
			</div>
		</div>
	</div>
</div>

<!-- Call to Action -->
<div class="container py-5">
	<div class="row justify-content-center">
		<div class="col-md-8 text-center">
			<h2 class="color-theme mb-4">Ready to Make a Difference?</h2>
			<p class="lead mb-4">Join our community of donors, volunteers, and agents working together to eliminate hunger.</p>
			<div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
				<a href="/auth/signup" class="btn btn-outline-primary btn-lg px-4">Get Started</a>
				<a href="/about-us" class="btn btn-outline-primary btn-lg px-4">Learn More</a>
			</div>
		</div>
	</div>
</div>