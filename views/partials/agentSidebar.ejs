<div id="sidebar-wrapper">
	<div class="sidebar-heading">
		<div class="d-flex align-items-center">
			<span>ShareBite Agent</span>
		</div>
	</div>
	<div class="list-group list-group-flush">
		<a href="/agent/dashboard" class="list-group-item list-group-item-action">
			<i class="fas fa-tachometer-alt me-2"></i>Dashboard
		</a>
		<a href="/agent/collections/pending" class="list-group-item list-group-item-action">
			<i class="fas fa-clock me-2"></i>My Pending Collections
		</a>
		<a href="/agent/collections/previous" class="list-group-item list-group-item-action">
			<i class="fas fa-history me-2"></i>Previous Collections
		</a>
		<a href="/agent/profile" class="list-group-item list-group-item-action">
			<i class="fas fa-user me-2"></i>My Profile
		</a>
		<a href="/auth/logout" class="list-group-item list-group-item-action text-danger">
			<i class="fas fa-sign-out-alt me-2"></i>Logout
		</a>
	</div>
</div>

<style>
#sidebar-wrapper {
	min-height: 100vh;
	width: 250px;
	background: #2c3e50;
	color: white;
	position: fixed;
	left: 0;
	top: 0;
	z-index: 1000;
	transition: all 0.3s ease;
}

.sidebar-heading {
	padding: 20px;
	background: #243342;
	font-size: 1.2rem;
	font-weight: 600;
}

.sidebar-logo {
	width: 40px;
	height: 40px;
}

.list-group-item {
	background: transparent;
	border: none;
	color: #ecf0f1;
	padding: 15px 20px;
	transition: all 0.3s ease;
}

.list-group-item:hover {
	background: #34495e;
	color: white;
}

.list-group-item.active {
	background: #3498db;
	color: white;
}

.list-group-item.text-danger {
	color: #ff6b6b !important;
}

.list-group-item.text-danger:hover {
	background: #e74c3c;
	color: white !important;
}

#main-wrapper {
	margin-left: 250px;
	transition: all 0.3s ease;
}

@media (max-width: 768px) {
	#sidebar-wrapper {
		margin-left: -250px;
	}
	#sidebar-wrapper.active {
		margin-left: 0;
	}
	#main-wrapper {
		margin-left: 0;
	}
}
</style>

<script>
	document.getElementById("sidebar-toggler-btn").onclick = function() {
		document.getElementById("sidebar-wrapper").classList.toggle("active");
	};
</script>