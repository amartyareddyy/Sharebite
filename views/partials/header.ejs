<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Food Donation Management System' %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
	<nav class="navbar navbar-expand-sm navbar-light p-0 h-100">
		<div class="container-fluid p-0">
			<a class="navbar-brand text-white ps-2" href="/">ShareBite</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
				aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span><i class="fas fa-bars text-white"></i></span>
			</button>
			<div class="collapse navbar-collapse ps-2" id="navbarSupportedContent" style="z-index: 100;">
				<ul class="navbar-nav ms-auto me-3">
					<li class="nav-item"><a class="nav-link" href="/about-us">About us</a></li>
					<li class="nav-item"><a class="nav-link" href="/contact-us">Contact us</a></li>
					<% if(typeof currentUser !== 'undefined' && currentUser) { %>
						<li class="nav-item">
							<a href="/<%= currentUser.role %>/profile" class="user-icon-link">
								<div class="user-icon"><%= currentUser.firstName[0] %></div>
							</a>
						</li>
					<% } else { %>
						<li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
						<li class="nav-item"><a class="nav-link" href="/auth/signup">Signup</a></li>
					<% } %>
				</ul>
			</div>
		</div>
	</nav>
</header>